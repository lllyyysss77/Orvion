# 数据库连接串（不设置则默认 SQLite: ./data/llmio.db）
# SQLite 示例：
# - sqlite://data/llmio.db
# - data/llmio.db
# - file:data/llmio.db?cache=shared
# PostgreSQL 支持两种格式：
# 1) key=value DSN: host=localhost user=postgres password=postgres dbname=llmio port=5432 sslmode=disable
# 2) URL（推荐）: postgres://postgres:postgres@localhost:5432/llmio?sslmode=disable

# Redis 配置（可选，用于RPM限流和IP锁定）
# 如果不配置，系统将使用内存存储
# 格式: redis://[username:password@]host:port/database
REDIS_URL=redis://localhost:6379/0
# 带密码的示例: redis://:password@localhost:6379/0
# 带用户名和密码的示例: redis://username:password@localhost:6379/0

# 服务端口
LLMIO_SERVER_PORT=7070

# 日志级别（debug/info/warn/error），生产环境建议 info 或 warn
LOG_LEVEL=info

# API 认证 Token
TOKEN=your_token_here

# Codex OAuth 配置（用于 Codex 官方订阅管理）
# CODEX_OAUTH_CLIENT_ID=app_xxx
# CODEX_OAUTH_REDIRECT_URL=http://localhost:1455/auth/callback
# CODEX_OAUTH_ENABLE_FORWARDER=true
# CODEX_SUBSCRIPTION_DIR=data/codex-auths
# CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage

# 限流器配置（可选）
# LIMITER_ENABLED=true
# LIMITER_DEFAULT_RPM=60
# LIMITER_DEFAULT_IP_LOCK_MINUTES=30
