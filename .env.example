# ========= 核心配置 =========

# 管理端与代理端的管理员令牌（为空时 /api/* 不做管理员鉴权）
TOKEN=your_token_here

# 服务端口（默认 7070）
ORVION_SERVER_PORT=7070

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 系统日志文件路径（默认 orvion.log）
LOG_FILE=orvion.log

# 优雅停机超时时间（秒，默认 10）
ORVION_SHUTDOWN_TIMEOUT_SECONDS=10


# ========= 数据库配置 =========

# 不设置时默认使用 SQLite: ./data/llmio.db
# SQLite 示例：
# DATABASE_DSN=sqlite://data/llmio.db
# DATABASE_DSN=data/llmio.db
# DATABASE_DSN=file:data/llmio.db?cache=shared
#
# PostgreSQL 示例：
# DATABASE_DSN=host=localhost user=postgres password=postgres dbname=llmio port=5432 sslmode=disable
# DATABASE_DSN=postgres://postgres:postgres@localhost:5432/llmio?sslmode=disable
# DATABASE_DSN=


# ========= 网络与兼容配置（可选） =========

# 可信代理（逗号分隔），用于正确识别客户端 IP
# TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8

# Gemini 兼容降级开关（默认开启）
# GEMINI_COMPAT_ENABLED=true

# GitHub 版本检查代理（可选）
# 已有本地代理时可直接指定：
# GITHUB_HTTP_PROXY=http://127.0.0.1:7890


# ========= Telegram（可选） =========

# 用于熔断告警与 TG 命令对话
# BREAKER_ALERT_TG_BOT_TOKEN=123456:abc
# BREAKER_ALERT_TG_CHAT_ID=123456789
# BREAKER_ALERT_TG_API_BASE=https://api.telegram.org
# TG 代理地址（可选）
# BREAKER_ALERT_TG_PROXY_URL=http://127.0.0.1:7890
# /status 状态图拉取地址（可选）
# BREAKER_ALERT_TG_STATUS_IMAGE_URL=https://i.mukyu.ru/random?wtf_gender=girls
